rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "pbhargavi344@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    match /announcements/{docId} {
      allow read: if true;
      allow list, get: if true;
      allow write: if isAdmin();
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validations ---
    
    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string && data.email.size() <= 200
        && data.fullName is string && data.fullName.size() <= 200
        && data.keys().hasAll(['uid', 'email', 'fullName'])
        && (data.isAdmin == false || !('isAdmin' in data)); // Users can't make themselves admin
    }

    function isValidCar(data) {
      return data.make is string && data.make.size() <= 100
        && data.model is string && data.model.size() <= 100
        && (data.year is number || data.year is string) 
        && data.keys().hasAll(['make', 'model', 'addedAt']);
    }

    function isValidBooking(data) {
      return data.userId == request.auth.uid
        && data.serviceId is string && data.serviceId.size() <= 100
        && data.date is string && data.date.size() == 10
        && data.timeSlot is string && data.timeSlot.size() <= 20
        && data.status in ['pending', 'confirmed', 'cancelled', 'completed']
        && data.keys().hasAll(['userId', 'serviceId', 'date', 'timeSlot', 'status', 'createdAt'])
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && data.createdAt == request.time;
    }

    // --- Collection Matches ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (isAdmin() || (
        incoming().diff(existing()).affectedKeys().hasAny(['fullName', 'phone', 'email', 'updatedAt'])
        && existing().isAdmin == (incoming().get('isAdmin', false))
      ));

      match /cars/{carId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidCar(incoming());
        allow update, delete: if isAdmin();
      }
    }

    match /bookings/{bookingId} {
      // Users can see their own bookings, admins see all
      // Restricted list allowed for availability checks
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn();
      
      // Allow creation for signed in users
      allow create: if isSignedIn() && isValidBooking(incoming()) && incoming().status == 'pending';
      
      allow update: if isSignedIn() && (
        // Admin Update: Approve / Reschedule / Complete
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasAny(['status', 'date', 'timeSlot'])) ||
        
        // User Update: Finalize booking details (customerDetails / carDetails / notes)
        (isOwner(existing().userId) && 
         incoming().diff(existing()).affectedKeys().hasAny(['customerDetails', 'carDetails', 'notes', 'updatedAt'])) ||

        // User Update: Cancel (only if pending/confirmed)
        (isOwner(existing().userId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
         incoming().status == 'cancelled' &&
         existing().status in ['pending', 'confirmed'])
      );
      
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read, list: if isAdmin();
      allow create: if isSignedIn(); // Users can create during checkout
    }

    match /services/{serviceId} {
      allow read: if true; // Publicly viewable
      allow write: if isAdmin();
    }

    match /availability_slots/{slotId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
